# ============================================================
# 项目运行时产物（不要提交）
# ============================================================

# 向量库持久化目录（体积大，可通过重建知识库恢复）
chroma_db/

# 运行日志
logs/
*.log

# SQLite 会话数据库（含用户对话数据）
data/sessions.db
*.db
*.sqlite3
# SQLite WAL 模式的旁路文件（会随写入频繁变动，且可能含未落盘的对话数据）
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm

# 清理/回滚用的数据库快照与临时工作目录（含用户对话数据，禁止提交）
.workbuddy/backups/
.workbuddy/_*

# 知识库 MD5 去重记录（随知识库重建生成）
md5.txt

# ============================================================
# 敏感信息（务必不要提交）
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets.yml
# 含真实服务端点的本地配置（仓库内只保留 rag.yml.example 模板）
config/rag.local.yml

